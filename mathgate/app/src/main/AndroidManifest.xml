<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV / 10-foot UI. No touchscreen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Intentionally NO INTERNET permission (roadmap, "Не цели"):
      the app is fully local, no cloud / accounts / analytics.
    -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      D-08: granted once over adb (pm grant), not via the UI.
      Lets SelfHealer re-enable the accessibility service.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Fallback detector (D-02). Granted via Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MathGateApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MathGate">

        <!-- First-run wizard; the only leanback launcher entry (phase 7). -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:theme="@style/Theme.MathGate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen challenge surface (phases 4-5). -->
        <activity
            android:name=".ui.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.MathGate.Block" />

        <!--
          Parent settings behind PIN (phase 7). Exported because it is the accessibility service
          `settingsActivity`: the system launches it from another process. The PIN gate is what
          protects the settings, not the export flag.
        -->
        <activity
            android:name=".ui.ParentActivity"
            android:exported="true"
            android:theme="@style/Theme.MathGate" />

        <!-- Primary foreground detector (D-02). -->
        <service
            android:name=".service.GuardAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Keep-alive service + fallback detector (D-07, D-11). -->
        <service
            android:name=".service.GuardForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental screen-time enforcement for a video app; keeps the foreground detector and self-healing alive." />
        </service>

        <!-- Restart after reboot (D-07). -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
